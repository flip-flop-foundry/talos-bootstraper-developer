{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Import environment",
      "type": "process",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/import-environment.sh",
      "args": [
        "${input:repoUrl}",
        "${input:envName}",
        "${workspaceFolder:devenv}/.local/talos-bootstrapper.code-workspace",
        "${env:TALOS_BOOTSTRAPPER_DATA_DIR}/environments",
        "${input:trustAllCerts}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Set Active Talos/Kube Context",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/set-active-talos-kube-context.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Render Overlay",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/render-overlay.sh",
      "args": [
        "${env:TALOS_BOOTSTRAPPER_DATA_DIR}/environments/${input:activeEnvName}/${input:activeEnvName}.env"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Render and Push to Gitea",
      "dependsOn": ["Render Overlay"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/push-to-gitea.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Reset Talos Node System Volumes",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/reset-talos-nodes.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Talos Image URLs",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/generate-image-urls.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Talos Upgrade Planner",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/talos-upgrade.sh",
      "args": [
        "${input:activeEnvName}",
        "${input:talosUpgradeReadOnly}",
        "${input:talosUpgradeInteractive}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare Node for Downtime",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/prepare-node-for-downtime.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Apply Talos configs",
      "type": "shell",
      "command": "if [ \"${input:talosDiffMode}\" = \"true\" ]; then \"${workspaceFolder:devenv}/.vscode/tasks/cluster-initialSetup.sh\" --diff \"${input:activeEnvName}\"; else \"${workspaceFolder:devenv}/.vscode/tasks/cluster-initialSetup.sh\" \"${input:activeEnvName}\"; fi",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Apply Overlay",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/cluster-bootstrap.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Setup PXE Server",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/pxe-setup.sh",
      "args": [
        "${input:activeEnvName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Bootstrap Customer",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/bootstrap-customer.sh",
      "args": [
        "${input:activeEnvName}",
        "${input:customerName}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Bootstrap Customer Repo",
      "detail": "Add a repo to an existing customer org (optionally seeded with the example app).",
      "type": "shell",
      "command": "${workspaceFolder:devenv}/.vscode/tasks/bootstrap-customer-repo.sh",
      "args": [
        "${input:activeEnvName}",
        "${input:customerOrgName}",
        "${input:customerRepoName}",
        "${input:customerRepoTemplate}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "repoUrl",
      "type": "promptString",
      "description": "Git repository URL to clone (leave empty to seed a new environment from the built-in template)",
      "default": ""
    },
    {
      "id": "envName",
      "type": "promptString",
      "description": "Environment name (optional when cloning — derived from the repo URL; required when seeding from the template)",
      "default": ""
    },
    {
      "id": "trustAllCerts",
      "type": "pickString",
      "description": "Trust all TLS certificates during git clone (use only for self-signed hosts)",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    },
    {
      "id": "activeEnvName",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "description": "Select an environment",
        "command": "for d in \"${env:TALOS_BOOTSTRAPPER_DATA_DIR}\"/environments/*/; do name=$(basename \"$d\"); [ -f \"$d/$name.env\" ] && echo \"$name\"; done",
        "taskId": "activeEnvName",
        "rememberPrevious": true
      }
    },
    {
      "id": "customerName",
      "type": "promptString",
      "description": "Customer name (lowercase, used as Gitea org name and namespace prefix)"
    },
    {
      "id": "customerOrgName",
      "type": "promptString",
      "description": "Existing customer Gitea org name"
    },
    {
      "id": "customerRepoName",
      "type": "promptString",
      "description": "New repo name (lowercase; namespace becomes <org>-<repo>)"
    },
    {
      "id": "customerRepoTemplate",
      "type": "pickString",
      "description": "Seed the new repo with the example application?",
      "options": [
        { "label": "No — empty repo", "value": "" },
        { "label": "Yes — push example app from template", "value": "--with-template" }
      ],
      "default": ""
    },
    {
      "id": "talosDiffMode",
      "type": "pickString",
      "description": "Apply Talos configs in diff mode?",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    },
    {
      "id": "talosUpgradeReadOnly",
      "type": "pickString",
      "description": "Run Talos upgrade in read-only mode?",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "id": "talosUpgradeInteractive",
      "type": "pickString",
      "description": "Confirm every command that changes a node?",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    }
  ]
}
